HF_TOKEN=your_huggingface_token
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=craneneo4j
CRANE_CHECKPOINT_PATH=checkpoints/latest.pt
CRANE_SAVE_EVERY=500
CRANE_TRAIN_STEPS=2000
CRANE_MEMORY_EVERY=50
CRANE_DECAY_ON_MEMORY=1
CRANE_EMBEDDING_DIM=256
CRANE_PROMPT="To be or not to be"
# Corpus: tinyshakespeare | wikitext2 | wikitext103  (see pipelines/fetch_corpus.py)
CRANE_CORPUS_PRESET=wikitext103
CRANE_TENSORBOARD=1
CRANE_TENSORBOARD_DIR=runs/crane
# CRANE_TENSORBOARD_RUN_NAME=my-run
# CRANE_TENSORBOARD_LOG_EVERY=50
# CRANE_TOKEN_CACHE_PATH=data/corpus.tokens.int32
# CRANE_REBUILD_TOKEN_CACHE=0
